# Default: DEMO, no services or credentials required.
DESOL_API_BASE_URL=
# Real mode requires the actual backend's device identifier.
DESOL_DEVICE_ID=
# Optional backend-only bearer token. Never use a VITE_ prefix.
DESOL_API_TOKEN=
# Set only to the confirmed hardware sampling interval, in seconds.
DESOL_SAMPLE_INTERVAL_SECONDS=
# ESP32 direto na rede local. Informe somente o IP privado, por exemplo:
# DESOL_ESP32_BASE_URL=http://192.168.1.50
DESOL_ESP32_BASE_URL=
